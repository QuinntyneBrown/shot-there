# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shotthere

# Origin of the map tile provider allowed in frame-src, e.g. https://maps.example.com (optional)
MAP_PROVIDER_ORIGIN=

# Public origin of the site; admin writes must come from it (CSRF check), e.g. https://shotthere.ca
SITE_ORIGIN=

# Used only by `npm run owner:set-password` to create the owner or reset its password
OWNER_EMAIL=
OWNER_PASSWORD=

# S3-compatible object storage for uploaded images
STORAGE_BUCKET=
# Endpoint for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public CDN base URL in front of the bucket, e.g. https://images.shotthere.ca
IMAGE_CDN_BASE_URL=
