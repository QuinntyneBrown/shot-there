{
  "project": "ShotThere",
  "required_states": {
    "page": ["default", "loading", "empty", "error"],
    "dialog": ["default", "busy", "invalid"],
    "notification": ["info", "success", "warning", "danger"]
  },
  "screens": [
    {
      "id": "home",
      "kind": "page",
      "title": "Home",
      "route": "/",
      "requirements": ["L2-039", "L2-041", "L2-035", "L2-046", "L2-048"],
      "states": ["default", "empty", "invalid", "submitting", "success", "error", "rate-limited"],
      "not_applicable": { "loading": "Server-rendered (L2-074): the page arrives complete; there is no client fetch to wait for." }
    },
    {
      "id": "studios",
      "kind": "page",
      "title": "Studios",
      "route": "/studios",
      "requirements": ["L2-021", "L2-022", "L2-023", "L2-025", "L2-026", "L2-030", "L2-043", "L2-046", "L2-069"],
      "states": ["default", "loading", "empty", "error", "no-results", "filtered", "selected-one", "selected"]
    },
    {
      "id": "spots",
      "kind": "page",
      "title": "Outdoor spots",
      "route": "/spots",
      "requirements": ["L2-024", "L2-025", "L2-026", "L2-019", "L2-069"],
      "states": ["default", "loading", "empty", "error", "no-results", "filtered"]
    },
    {
      "id": "map",
      "kind": "page",
      "title": "Map",
      "route": "/map",
      "requirements": ["L2-027", "L2-028", "L2-029", "L2-086"],
      "states": ["default", "list", "studios-only", "loading", "empty", "error", "tiles-failed"]
    },
    {
      "id": "studio",
      "kind": "page",
      "title": "Studio review",
      "route": "/studios/:slug",
      "requirements": ["L2-003", "L2-004", "L2-005", "L2-006", "L2-007", "L2-008", "L2-009", "L2-010", "L2-011", "L2-012", "L2-013", "L2-030", "L2-036", "L2-043", "L2-047", "L2-048", "L2-086"],
      "states": ["default", "stale", "minimal", "playing", "media-failed", "in-compare"],
      "not_applicable": {
        "loading": "Server-rendered (L2-074): the review arrives complete in the HTML.",
        "empty": "A single review, not a collection; a draft or unknown slug is the not-found page (L2-001).",
        "error": "A failed render returns the server-error page (L2-083); media failures are the media-failed state."
      }
    },
    {
      "id": "spot",
      "kind": "page",
      "title": "Outdoor spot",
      "route": "/spots/:slug",
      "requirements": ["L2-014", "L2-015", "L2-016", "L2-017", "L2-018", "L2-019", "L2-020", "L2-037", "L2-038", "L2-043", "L2-047", "L2-086"],
      "states": ["default", "stale-permit", "no-rain-backup", "no-video", "map-failed"],
      "not_applicable": {
        "loading": "Server-rendered (L2-074): the spot page arrives complete in the HTML.",
        "empty": "A single spot, not a collection; the rain-backup section has its own empty state (no-rain-backup).",
        "error": "A failed render returns the server-error page (L2-083); a map failure is the map-failed state."
      }
    },
    {
      "id": "compare",
      "kind": "page",
      "title": "Compare studios",
      "route": "/compare?studios=a,b",
      "requirements": ["L2-031", "L2-032", "L2-033", "L2-043"],
      "states": ["default", "four", "empty", "unknown-slug", "over-limit"],
      "not_applicable": {
        "loading": "Server-rendered for the slugs in the URL (L2-033.1); no client fetch.",
        "error": "A failed render returns the server-error page (L2-083); unknown slugs are the unknown-slug state."
      }
    },
    {
      "id": "guides",
      "kind": "page",
      "title": "Guides",
      "route": "/guides",
      "requirements": ["L2-035"],
      "states": ["default", "empty"],
      "not_applicable": {
        "loading": "Server-rendered (L2-074.3): every published guide is in the HTML.",
        "error": "A failed render returns the server-error page (L2-083)."
      }
    },
    {
      "id": "guide",
      "kind": "page",
      "title": "Guide",
      "route": "/guides/:slug",
      "requirements": ["L2-034"],
      "states": ["default"],
      "not_applicable": {
        "loading": "Server-rendered (L2-074): entries arrive in the HTML.",
        "empty": "A guide cannot be published without entries (L2-060.3); entries whose location became draft are simply omitted (L2-034.2).",
        "error": "A failed render returns the server-error page (L2-083)."
      }
    },
    {
      "id": "editorial-policy",
      "kind": "page",
      "title": "Editorial policy",
      "route": "/editorial-policy",
      "requirements": ["L2-046"],
      "states": ["default"],
      "not_applicable": {
        "loading": "Static content.",
        "empty": "Static content.",
        "error": "Static content; a failed render returns the server-error page."
      }
    },
    {
      "id": "not-found",
      "kind": "page",
      "title": "Page not found",
      "route": "(any unknown or draft URL)",
      "requirements": ["L2-083", "L2-001"],
      "states": ["default"],
      "not_applicable": {
        "loading": "This page is itself an error state.",
        "empty": "This page is itself an error state.",
        "error": "This page is itself an error state."
      }
    },
    {
      "id": "server-error",
      "kind": "page",
      "title": "Something went wrong",
      "route": "(any URL, HTTP 500)",
      "requirements": ["L2-083"],
      "states": ["default"],
      "not_applicable": {
        "loading": "This page is itself an error state.",
        "empty": "This page is itself an error state.",
        "error": "This page is itself an error state."
      }
    },
    {
      "id": "sign-in",
      "kind": "page",
      "title": "Owner sign-in",
      "route": "/admin/sign-in",
      "requirements": ["L2-049", "L2-050", "L2-051", "L2-052"],
      "states": ["default", "invalid", "incorrect", "submitting", "rate-limited", "error", "session-expired", "signed-out"],
      "not_applicable": {
        "loading": "A static form; nothing is fetched before it renders.",
        "empty": "A form, not a collection."
      }
    },
    {
      "id": "admin-dashboard",
      "kind": "page",
      "title": "Dashboard",
      "route": "/admin",
      "requirements": ["L2-053", "L2-044", "L2-052"],
      "states": ["default", "loading", "empty", "error", "up-to-date", "partial"]
    },
    {
      "id": "admin-studios",
      "kind": "page",
      "title": "Studios (admin)",
      "route": "/admin/studios",
      "requirements": ["L2-063", "L2-043"],
      "states": ["default", "loading", "empty", "error", "no-results"]
    },
    {
      "id": "admin-spots",
      "kind": "page",
      "title": "Spots (admin)",
      "route": "/admin/spots",
      "requirements": ["L2-063", "L2-043"],
      "states": ["default", "loading", "empty", "error", "no-results"]
    },
    {
      "id": "admin-guides",
      "kind": "page",
      "title": "Guides (admin)",
      "route": "/admin/guides",
      "requirements": ["L2-063"],
      "states": ["default", "loading", "empty", "error", "no-results"]
    },
    {
      "id": "studio-editor",
      "kind": "page",
      "title": "Studio editor",
      "route": "/admin/studios/new, /admin/studios/:id",
      "requirements": ["L2-054", "L2-042", "L2-045", "L2-057", "L2-058", "L2-059", "L2-002", "L2-056", "L2-061", "L2-062"],
      "states": ["new", "default", "published", "loading", "error", "invalid", "submitting", "success", "uploading", "upload-failed", "price-changed"],
      "not_applicable": { "empty": "An editor always shows its form; a studio with no values yet is the new state." }
    },
    {
      "id": "spot-editor",
      "kind": "page",
      "title": "Spot editor",
      "route": "/admin/spots/new, /admin/spots/:id",
      "requirements": ["L2-055", "L2-042", "L2-045", "L2-056", "L2-057", "L2-059", "L2-061", "L2-062"],
      "states": ["new", "default", "published", "loading", "error", "invalid", "submitting", "success"],
      "not_applicable": { "empty": "An editor always shows its form; a spot with no values yet is the new state." }
    },
    {
      "id": "guide-editor",
      "kind": "page",
      "title": "Guide editor",
      "route": "/admin/guides/new, /admin/guides/:id",
      "requirements": ["L2-060", "L2-061", "L2-062"],
      "states": ["new", "default", "published", "loading", "error", "invalid", "submitting", "success"],
      "not_applicable": { "empty": "An editor always shows its form; a guide with no entries yet is the new state." }
    },
    {
      "id": "studio-filters",
      "kind": "dialog",
      "title": "Studio filters",
      "opens_from": "studios",
      "requirements": ["L2-022", "L2-023", "L2-025", "L2-067"],
      "states": ["default", "selected", "invalid"],
      "not_applicable": { "busy": "Apply changes the URL only; the list then shows its own loading state (studios/loading)." }
    },
    {
      "id": "spot-filters",
      "kind": "dialog",
      "title": "Spot filters",
      "opens_from": "spots",
      "requirements": ["L2-024", "L2-025", "L2-067"],
      "states": ["default", "selected"],
      "not_applicable": {
        "busy": "Apply changes the URL only; the list then shows its own loading state (spots/loading).",
        "invalid": "Only checkboxes and radio buttons; every combination is valid."
      }
    },
    {
      "id": "map-popup",
      "kind": "dialog",
      "title": "Map marker popup",
      "opens_from": "map",
      "requirements": ["L2-028"],
      "states": ["default", "spot"],
      "not_applicable": {
        "busy": "Shows data already loaded with the markers; no request.",
        "invalid": "No inputs."
      }
    },
    {
      "id": "lightbox",
      "kind": "dialog",
      "title": "Photo lightbox",
      "opens_from": "studio",
      "requirements": ["L2-010", "L2-016", "L2-067", "L2-086"],
      "states": ["default", "sample-shot", "last", "image-failed"],
      "not_applicable": {
        "busy": "The full image streams in place; a failed image is the image-failed state.",
        "invalid": "No inputs."
      }
    },
    {
      "id": "site-menu",
      "kind": "dialog",
      "title": "Site menu",
      "opens_from": "home",
      "requirements": ["L2-064", "L2-035", "L2-052"],
      "states": ["default", "admin"],
      "not_applicable": {
        "busy": "Navigation only.",
        "invalid": "No inputs."
      }
    },
    {
      "id": "missing-fields",
      "kind": "dialog",
      "title": "Can't publish yet",
      "opens_from": "studio-editor",
      "requirements": ["L2-056", "L2-002", "L2-045", "L2-055", "L2-060"],
      "states": ["default", "spot"],
      "not_applicable": {
        "busy": "Opens after the refused publish request; its links only move focus.",
        "invalid": "No inputs; it lists the fields that are invalid in the editor."
      }
    },
    {
      "id": "unpublish",
      "kind": "dialog",
      "title": "Unpublish",
      "opens_from": "studio-editor",
      "requirements": ["L2-056"],
      "states": ["default", "busy", "failed"],
      "not_applicable": { "invalid": "A confirmation with no inputs." }
    },
    {
      "id": "delete-content",
      "kind": "dialog",
      "title": "Delete",
      "opens_from": "studio-editor",
      "requirements": ["L2-061"],
      "states": ["default", "busy", "failed"],
      "not_applicable": { "invalid": "A confirmation that names the item; no typed confirmation (L2-061)." }
    },
    {
      "id": "remove-image",
      "kind": "dialog",
      "title": "Remove image",
      "opens_from": "studio-editor",
      "requirements": ["L2-058"],
      "states": ["default", "refused"],
      "not_applicable": {
        "busy": "Removal is staged in the form and saved with the studio; no request from the dialog.",
        "invalid": "A confirmation with no inputs."
      }
    },
    {
      "id": "discard-changes",
      "kind": "dialog",
      "title": "Discard changes",
      "opens_from": "studio-editor",
      "requirements": ["L2-062"],
      "states": ["default"],
      "not_applicable": {
        "busy": "Discarding is local; no request.",
        "invalid": "A confirmation with no inputs."
      }
    },
    {
      "id": "guide-entry-picker",
      "kind": "dialog",
      "title": "Add guide entry",
      "opens_from": "guide-editor",
      "requirements": ["L2-060"],
      "states": ["default", "busy", "results", "invalid", "no-matches"]
    },
    {
      "id": "admin-toast",
      "kind": "notification",
      "title": "Admin toasts",
      "opens_from": "studio-editor",
      "requirements": ["L2-054", "L2-056", "L2-061"],
      "states": ["info", "success", "warning", "danger", "stacked"]
    },
    {
      "id": "public-toast",
      "kind": "notification",
      "title": "Public toasts",
      "opens_from": "compare",
      "requirements": ["L2-030", "L2-032"],
      "states": ["success", "warning", "danger"],
      "not_applicable": { "info": "The public site has no informational toasts; result counts are announced in a live region instead (L2-069.3)." }
    }
  ]
}
