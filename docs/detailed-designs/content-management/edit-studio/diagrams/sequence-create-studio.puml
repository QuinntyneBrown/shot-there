@startuml
title UML sequence behaviour — Create a studio
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — ShotThere web (Angular SSR)" #E0F2FE
  participant "StudioEditorPageComponent" as page
  participant "studio-form.ts" as form
  participant "HttpStudioEditorService" as svc
end box
box "Backend — ShotThere API (Next.js route handlers)" #D1FADF
  participant "app/api/admin/studios/route.ts" as route
end box
box "Backend — ShotThere application (lib/)" #ECFDF3
  participant "requireOwnerSession" as auth
  participant "createStudio" as create
  participant "studioInputSchema" as schema
  participant "assignUniqueSlug" as slug
end box
box "Backend — Infrastructure (Prisma / object storage)" #FFF4E5
  database "ShotThere database" as db
end box
owner -> page : Activate "New studio" and fill the basics
owner -> page : Save
page -> form : toStudioInput()
form --> page : StudioInput
page -> svc : create(input)
svc -> route : POST /api/admin/studios with st_session cookie
route -> auth : Validate session
alt no valid owner session
  auth --> route : Unauthorized
  route --> svc : HTTP 401
  svc --> page : Error
  page --> owner : Redirect to sign-in (maintain-owner-session)
else owner session valid
  auth --> route : Owner
  route -> create : createStudio(input, today)
  create -> schema : safeParse(input) (L2-054)
  alt invalid input
    schema --> create : Field issues
    create --> route : FieldErrors
    route --> svc : HTTP 400 FieldErrors
    svc --> page : FieldErrors
    page --> owner : Field-level messages beside each field (L2-054)
  else valid input
    schema --> create : Parsed input
    create -> slug : assignUniqueSlug(name)
    slug -> db : Find slugs starting with the base slug
    db --> slug : Existing slugs
    slug --> create : Slug with numeric suffix when taken (L2-054)
    create -> db : Insert Studio (status draft, priceVerifiedAt = today unless supplied), StudioFee and GearItem rows in one transaction (L2-054, L2-042)
    db --> create : Created rows
    create --> route : StudioEditorModel
    route --> svc : HTTP 201 StudioEditorModel
    svc --> page : StudioEditorModel
    page --> owner : Navigate to the studio edit screen with a success message and the final slug
  end
end
@enduml
