@startuml
title UML sequence behaviour — Toggle map and list at phone width
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — ShotThere web (Angular SSR)" #E0F2FE
  participant "MapPageComponent" as page
  participant "LocationsMapComponent" as map
  participant "MapLocationCardComponent" as card
end box
alt viewport is XS or SM
  page --> actor : "Map" and "List" toggle; map fills viewport height below header, no horizontal scroll (L2-029)
  actor -> page : Select "List"
  page -> page : Navigate with view=list
  page -> map : Hide
  page -> card : Render one card per visible MapLocation
  card --> actor : Same locations as cards (L2-029)
  actor -> page : Select "Map"
  page -> page : Navigate with view=map
  page -> map : Show
else viewport is LG or above
  page -> card : Render list
  page -> map : Render map beside the list
  page --> actor : List and map side by side, no toggle (L2-029)
end
@enduml
