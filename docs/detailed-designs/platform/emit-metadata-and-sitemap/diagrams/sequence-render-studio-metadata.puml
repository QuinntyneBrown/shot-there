@startuml
title UML sequence behaviour — Render studio metadata
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Crawler or visitor" as actor
box "Frontend — ShotThere web (Angular SSR)" #E0F2FE
  participant "StudioPageComponent" as page
  participant "HttpStudioService" as svc
  participant "buildStudioJsonLd" as ld
  participant "PageMetadataService" as meta
end box
box "Backend — ShotThere API (Next.js route handlers)" #D1FADF
  participant "studios/[slug] route.ts" as route
end box
box "Backend — ShotThere application (lib/)" #ECFDF3
  participant "getStudio" as get
end box
box "Backend — Infrastructure (Prisma / object storage)" #FFF4E5
  database "ShotThere database" as db
end box
actor -> page : GET /studios/{slug}
page -> svc : getStudio(slug)
svc -> route : GET /api/studios/{slug}
route -> get : getStudio(slug)
get -> db : Read published studio
db --> get : Studio
get --> route : StudioDto with ogImageUrl
route --> svc : 200 StudioDto
svc --> page : StudioDto
page -> meta : set(title, description, path, ogImageUrl) (L2-076)
meta -> meta : Write title, description, canonical = SITE_ORIGIN + path, og:image 1200x630
page -> ld : buildStudioJsonLd(studio)
ld --> page : LocalBusiness with Review and AggregateRating, rating 1 to 5 (L2-076)
page -> meta : setJsonLd(data)
page --> actor : HTML with head metadata and JSON-LD
@enduml
