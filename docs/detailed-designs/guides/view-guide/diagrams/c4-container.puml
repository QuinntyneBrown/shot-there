@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View a guide

Person(visitor, "Visitor", "Plans a photo shoot in Toronto")
System_Boundary(shotthere, "ShotThere") {
  Container(web, "ShotThere web", "Angular SSR", "Renders the guide page")
  Container(api, "ShotThere API", "Next.js route handlers", "GET /api/guides/{slug}")
  ContainerDb(db, "ShotThere database", "PostgreSQL", "Guides, entries, studios, spots")
  ContainerDb(storage, "Image store", "Object storage", "Card image variants")
}
Rel(visitor, web, "Opens guide", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads", "Prisma")
Rel(visitor, storage, "Loads card images", "HTTPS via CDN")
@enduml
