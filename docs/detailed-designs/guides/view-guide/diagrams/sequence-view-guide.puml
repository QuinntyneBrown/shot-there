@startuml
title UML sequence behaviour — View a guide
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — ShotThere web (Angular SSR)" #E0F2FE
  participant "GuidePageComponent" as page
  participant "HttpGuideService" as svc
end box
box "Backend — ShotThere API (Next.js route handlers)" #D1FADF
  participant "app/api/guides/[slug]/route.ts" as route
end box
box "Backend — ShotThere application (lib/)" #ECFDF3
  participant "getGuide" as lib
end box
box "Backend — Infrastructure (Prisma / object storage)" #FFF4E5
  database "ShotThere database" as db
end box
actor -> page : Open guide
page -> svc : getGuide(slug)
svc -> route : GET /api/guides/{slug}
route -> lib : getGuide(slug)
lib -> db : Find published Guide with entries by position
db --> lib : Guide or none
alt guide missing or draft
  lib --> route : null
  route --> svc : 404
  svc --> page : not found
  page --> actor : Not-found page
else published guide
  lib -> lib : Omit entries whose location is draft (L2-034)
  lib -> lib : Compute current allInCost2h and data points (L2-034)
  lib --> route : GuideDto
  route --> svc : 200 JSON
  svc --> page : GuideDto
  page --> actor : Title, introduction, ordered entries in one column
end
@enduml
