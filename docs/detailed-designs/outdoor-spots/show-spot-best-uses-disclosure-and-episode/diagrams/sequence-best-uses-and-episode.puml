@startuml
title UML sequence behaviour — Show spot best uses, disclosure and episode
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — ShotThere web (Angular SSR)" #E0F2FE
  participant "SpotPageComponent" as page
  participant "SpotBestUsesComponent" as uses
  participant "SpotDisclosureComponent" as disc
  participant "Episode embed" as embed
  participant "SpotsService" as svc
end box
box "Backend — ShotThere API (Next.js route handlers)" #D1FADF
  participant "app/api/spots/[slug]/route.ts" as route
end box
box "Backend — ShotThere application (lib/)" #ECFDF3
  participant "lib/spots/get-spot.ts" as getspot
end box
box "Backend — Infrastructure (Prisma / object storage)" #FFF4E5
  database "ShotThere database" as db
end box
actor -> page : Open /spots/[slug]
page -> svc : getSpot(slug)
svc -> route : GET /api/spots/[slug]
route -> getspot : getSpot(slug)
getspot -> db : Find Spot by slug where published
alt published spot found
  db --> getspot : Spot row
  getspot --> route : SpotDetailDto with bestUses, disclosure, videoId
  route --> svc : 200 SpotDetailDto
  svc --> page : SpotDetailDto
  page -> uses : Pass bestUses
  uses --> actor : Only stored tags, each linking to the filtered spot list (L2-019)
  page -> disc : Pass disclosure
  disc --> actor : Disclosure near best uses (L2-020)
  opt videoId present
    page -> embed : Pass videoId
    embed --> actor : Player in a 16:9 container (L2-020)
  end
else no published spot
  db --> getspot : null
  getspot --> route : null
  route --> svc : 404
  svc --> page : Error result
  page --> actor : Show not-found state
end
@enduml
