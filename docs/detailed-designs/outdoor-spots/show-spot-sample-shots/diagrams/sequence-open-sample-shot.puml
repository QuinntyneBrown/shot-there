@startuml
title UML sequence behaviour — Show spot sample shots
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — ShotThere web (Angular SSR)" #E0F2FE
  participant "SpotPageComponent" as page
  participant "SpotSampleShotsComponent" as shots
  participant "Gallery lightbox" as lightbox
  participant "SpotsService" as svc
end box
box "Backend — ShotThere API (Next.js route handlers)" #D1FADF
  participant "app/api/spots/[slug]/route.ts" as route
end box
box "Backend — ShotThere application (lib/)" #ECFDF3
  participant "lib/spots/get-spot.ts" as getspot
end box
box "Backend — Infrastructure (Prisma / object storage)" #FFF4E5
  database "ShotThere database" as db
end box
actor -> page : Open /spots/[slug]
page -> svc : getSpot(slug)
svc -> route : GET /api/spots/[slug]
route -> getspot : getSpot(slug)
getspot -> db : Find Spot by slug where published
alt published spot found
  db --> getspot : Spot with sample-shot Image and ImageVariant rows
  getspot --> route : SpotDetailDto with sampleShots
  route --> svc : 200 SpotDetailDto
  svc --> page : SpotDetailDto
  page -> shots : Pass sampleShots
  shots --> actor : Thumbnails, 2 columns at XS, 4 at LG, caption "85 mm" and note (L2-016)
  actor -> shots : Activate a thumbnail
  shots -> lightbox : Open at index with alt, focal length and note
  lightbox --> actor : Full image with caption (L2-016)
else no published spot
  db --> getspot : null
  getspot --> route : null
  route --> svc : 404
  svc --> page : Error result
  page --> actor : Show not-found state
end
@enduml
