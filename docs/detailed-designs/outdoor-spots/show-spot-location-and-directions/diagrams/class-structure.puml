@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Show spot location and directions

abstract class SpotsService {
  +getSpot(slug: string): Observable<SpotDetailDto>
}
class HttpSpotsService {
  -http: HttpClient
  +getSpot(slug: string): Observable<SpotDetailDto>
}
class SpotPageComponent {
  -spots: SpotsService
  +spot: Signal<SpotDetailDto | undefined>
}
SpotsService <|-- HttpSpotsService
SpotPageComponent ..> SpotsService : injects
class SpotDetailDto {
  +slug: string
  +name: string
  +neighbourhood: string
  +latitude: number
  +longitude: number
  +directions: string
}
class SpotMapComponent {
  +name: InputSignal<string>
  +latitude: InputSignal<number>
  +longitude: InputSignal<number>
}
SpotPageComponent --> SpotDetailDto : renders
SpotPageComponent *-- SpotMapComponent : hosts
SpotsService ..> SpotDetailDto : returns
@enduml
