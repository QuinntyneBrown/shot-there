@startuml
title UML sequence behaviour — View the episode section
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as visitor
box "Frontend — ShotThere web (Angular SSR)" #E0F2FE
  participant "StudioPageComponent" as page
  participant "StudioEpisodeComponent" as ep
  participant "EpisodePlayerComponent (video/play-episode)" as player
  participant "HttpStudioService" as svc
end box
box "Backend — ShotThere API (Next.js route handlers)" #D1FADF
  participant "GET /api/studios/[slug]" as route
end box
box "Backend — ShotThere application (lib/)" #ECFDF3
  participant "getStudio" as get
end box
box "Backend — Infrastructure (Prisma / object storage)" #FFF4E5
  database "ShotThere database" as db
end box
visitor -> page : Open the studio page for a slug
page -> svc : getStudio(slug)
svc -> route : GET /api/studios/[slug]
route -> get : getStudio(slug, today)
get -> db : Find Studio by slug where published (L2-001)
db --> get : Studio with related rows or none
alt published studio found
  get -> get : episode = youtubeVideoId present ? videoId and title : null
  get --> route : StudioDetailDto
  route --> svc : 200 JSON
  svc --> page : StudioDetailDto
  alt episode present
    page -> ep : episode
    ep -> player : videoId, title
    player --> ep : Poster with play control
    ep --> visitor : Watch the episode section, 16:9 at full width (L2-013)
  else episode is null
    page --> visitor : No video section or placeholder (L2-013)
  end
else studio missing or draft
  get --> route : null
  route --> svc : 404
  svc --> page : Not found
  page --> visitor : Show not-found page
end
@enduml
